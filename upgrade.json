{
    "ignore": [
        "/src/*/",
        "/.env",
        "/.staticphp/",
        "/vendor/",
        "/node_modules/",
        "/composer.lock",
        "/package-lock.json"
    ],
    "once": [
        "/README.md",
        "/.version"
    ],
    "strip": [
        "/.github/",
        "/scripts/version.bash",
        "/scripts/release_tag.bash",
        "/scripts/upgrade_v2_namespaces.bash",
        "/scripts/i18n_integration.php",
        "/scripts/migrations_integration.php",
        "/tests/",
        "/phpunit.xml",
        "/docs/",
        "/resources/",
        "/LICENSE",
        "/UPGRADE.md",
        "/CHANGELOG.md"
    ],
    "app": {
        "ignore": [
            "/.env",
            "/Cache/",
            "/Files/"
        ],
        "once": [],
        "strip": []
    }
}
