parameters:
    paths:
        - lib
        - src
        - scripts
        - staticphp
        # SKELETON ONLY - scripts/post_create_project.php deletes the marked blocks when it
        # generates a project. tests/ is the tooling suite and is stripped along with them.
        - tests
        # END SKELETON ONLY

    # Defines the path constants the framework creates at runtime, so the config files can be
    # analysed rather than written off. See the file for why.
    bootstrapFiles:
        - scripts/phpstan_bootstrap.php

    excludePaths:
        analyseAndScan:
            # Twig's compiled templates. Generated, gitignored, and not ours to fix.
            - src/*/Cache/*

    # No baseline file, and it should stay that way - an application generated from this
    # inherits the config as its own starting point, and a baseline it did not create is
    # just inherited debt. The framework itself is analysed in the staticphp-core repository.
    #
    # 10 is held up by the framework rather than by anything here: Config::$items is declared
    # as a bare array, so every read off it is mixed. Worth revisiting once core is annotated.
    level: 9

    # SKELETON ONLY - the only entry here covers the integration scripts, which are stripped
    # from a generated project; left behind, phpstan would fail on the unmatched pattern.
    ignoreErrors:
        # $checks and $failures are globals the check() helpers increment. phpstan analyses
        # the top level scope only, where they are still the literal 0 they were assigned.
        -
            message: '#Strict comparison using === between 0 and 0 will always evaluate to true#'
            paths:
                - scripts/i18n_integration.php
                - scripts/migrations_integration.php
    # END SKELETON ONLY
