Options -Indexes

# Never serve dotfiles, .env or backup/editor leftovers as static files
<FilesMatch "(^\.|\.(env|ini|log|sql|bak|swp|dist|orig|save)$|~$)">
    Require all denied
</FilesMatch>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # For javascript handling using controller
    # RewriteCond %{REQUEST_FILENAME} -f
    # RewriteRule ^js/.* index.php [L]

    ## Avoid opening config
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^Config/.*$ index.php/$1 [L]

    # RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^(.*)$ index.php/$1 [L]
</IfModule>