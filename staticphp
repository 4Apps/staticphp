#!/usr/bin/env php
<?php

define('SAPI', 'cli');

require __DIR__ . '/vendor/autoload.php';

// These are dispatched here, before the routing bootstrap at the bottom of this file.
// Routing config has no notion of a cli-only route, so reaching them through a controller
// would also expose them over http - on tools whose job is to change the schema, delete
// translation keys and delete history.
//
// The framework's own commands come from the package rather than being listed here, so
// adding one there does not need a matching release of this skeleton. Application commands
// go in $localCommands and win on a name collision.
$localCommands = [];

// The skeleton's own commands, from lib/. They resolve first, and deliberately ahead of the
// framework check below, because none of them touch the framework - upgrading in particular
// has to keep working when the installed core is broken or missing, which is one of the
// reasons to reach for it. They are kept in a generated project on purpose: presets/ ships
// with it, so a project can add a second application later and pull in a later release.
$cliCommands = $localCommands + StaticPHP\Skeleton\Cli::commands();

// Help answers before the framework check below, and lists whatever is registered at the
// time. On a broken or half-installed core that means a short list rather than an error,
// which is more use than refusing to say anything at all.
if (count($argv) === 1 || in_array($argv[1], ['--help', '-h', 'help'], true)) {
    if (class_exists(StaticPHP\Core\Cli::class)) {
        $cliCommands += StaticPHP\Core\Cli::commands();
    }

    echo StaticPHP\Skeleton\Cli::help($cliCommands);

    // Asking for help succeeded; being given nothing to do did not
    exit(count($argv) === 1 ? 1 : 0);
}

if (isset($cliCommands[$argv[1]])) {
    $class = $cliCommands[$argv[1]];

    exit($class::run(array_slice($argv, 2), __DIR__));
}

if (class_exists(StaticPHP\Core\Cli::class) === false) {
    fwrite(STDERR, "error: this skeleton needs a framework that exports StaticPHP\\Core\\Cli\n");
    fwrite(STDERR, "run: composer update 4apps/staticphp-core\n");
    exit(1);
}

$cliCommands += StaticPHP\Core\Cli::commands();

if (isset($cliCommands[$argv[1]])) {
    $class = $cliCommands[$argv[1]];

    exit($class::run(array_slice($argv, 2), __DIR__));
}

// Go through all arguments
$last_param = null;
foreach ($argv as $param) {
    switch ($last_param) {
        case '--query':
            parse_str($param, $_GET);
            $_SERVER['QUERY_STRING'] = $param;
            continue 2;

        case '--post':
            parse_str($param, $_POST);
            continue 2;

        case '--project':
            $projectPath = dirname(__FILE__)."/src/{$param}/Public";
            if (is_dir($projectPath) == false) {
                echo "Project '{$param}' not found\n";
                exit -1;
            }

            define('PUBLIC_PATH', $projectPath);
            continue 2;
    }
    $last_param = null;

    switch ($param) {
        case '--help':
            echo StaticPHP\Skeleton\Cli::help($cliCommands);
            exit(0);
        case '--project':
        case '--query':
        case '--post':
            $last_param = $param;
            continue 2;
        case '--https':
            $_SERVER['HTTPS'] = 'on';
            continue 2;
        default:
            $_SERVER['REQUEST_URI'] = $param;
            continue 2;
    }
}

// Fill in some default data
$_SERVER['HTTP_HOST'] = 'localhost';
$_SERVER['SERVER_PORT'] = empty($_SERVER['HTTPS']) ? 80 : 443;
$_SERVER['REQUEST_METHOD'] = empty($_POST) ? 'GET' : 'POST';
$_SERVER['HTTP_USER_AGENT'] = (
    'Mozilla/5.0 (Windows NT 10.0; Win64; x64)'
    . ' AppleWebKit/537.36 (KHTML, like Gecko)'
    . ' Chrome/57.0.2987.133 Safari/537.36'
);
$_SERVER['REMOTE_ADDR'] = '127.0.0.1';

// Bootstrap. --project may already have pinned this; the skeleton's own app is the default.
if (defined('PUBLIC_PATH') === false) {
    define('PUBLIC_PATH', __DIR__ . '/src/Application/Public');
}

require StaticPHP\Core\Bootstrap::FILE;
