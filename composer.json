{
    "name": "4apps/staticphp",
    "description": "Application skeleton for the StaticPHP framework",
    "license": "MIT",
    "type": "project",
    "authors": [
        {
            "name": "Gints Murans",
            "email": "gm@gm.lv"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": ">=8.4",
        "ext-intl": "*",
        "ext-mbstring": "*",
        "ext-pdo": "*",
        "4apps/staticphp-core": "^2.0",
        "twig/twig": "^3.0",
        "symfony/dotenv": "^8.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^13.0",
        "squizlabs/php_codesniffer": "^4.0"
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "post-create-project-cmd": [
            "@php scripts/post_create_project.php --new-project",
            "@composer update --lock --no-interaction"
        ],
        "setup": "@php scripts/post_create_project.php",
        "test": "for c in src/*/phpunit.xml; do [ -f \"$c\" ] || continue; php vendor/bin/phpunit -c \"$c\" || exit 1; done",
        "lint": "@php vendor/bin/phpcs --standard=phpcs.xml src",
        "stan": "@php vendor/bin/phpstan analyse --no-progress --memory-limit=1G"
    }
}
