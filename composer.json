{
    "name": "4apps/staticphp",
    "description": "A lightweight PHP framework",
    "license": "MIT",
    "type": "project",
    "authors": [
        {
            "name": "Gints Murans",
            "email": "gm@gm.lv"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": ">=8.1",
        "twig/twig": "^3.0",
        "symfony/dotenv": "^6.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0",
        "squizlabs/php_codesniffer": "^3.6"
    },
    "autoload": {
        "classmap": [
            "src/System",
            "src/Application"
        ],
        "exclude-from-classmap": [
            "src/System/Tests/",
            "src/Application/Tests/"
        ]
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": [
            "@php vendor/bin/phpunit -c src/System/phpunit.xml",
            "@php vendor/bin/phpunit -c src/Application/phpunit.xml"
        ],
        "lint": "@php vendor/bin/phpcs --standard=phpcs.xml src"
    }
}
