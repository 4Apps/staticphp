{
  "name": "staticphp",
  "version": "1.0.0",
  "description": "",
  "author": "",
  "license": "MIT",
  "private": true,
  "main": "",
  "repository": {
    "type": "git",
    "url": "git@github.com:gintsmurans/staticphp.git"
  },
  "bugs": {
    "url": "https://github.com/gintsmurans/staticphp/issues"
  },
  "homepage": "https://github.com/gintsmurans/staticphp",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "./scripts/code_tests.bash",
    "start": "php -S 0.0.0.0:8081 -t src/Application/Public",
    "setup": "npm run composer:init && npm run mkdirs && npm run copy-fonts",
    "composer:init": "[ -f composer.lock ] || composer install",
    "mkdirs": "mkdir -p src/Application/Public/assets/dist/webfonts src/Application/Public/assets/dist/css src/Application/Public/assets/dist/js",
    "copy-fonts": "mkdir -p src/Application/Public/assets/dist/webfonts; cp -r node_modules/\\@fortawesome/fontawesome-free/webfonts/* src/Application/Public/assets/dist/webfonts/;",
    "build:info": "./scripts/build_info.bash",
    "build": "npm run copy-fonts && npm run css:build && npm run js:build",
    "build:dev": "npm run copy-fonts && npm run css:build && npm run js:build:dev",
    "js:build": "npm run typecheck && rspack build --mode production",
    "js:build:dev": "npm run typecheck && rspack build --mode development",
    "js:watch": "rspack build --watch --mode development",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/Application/Public/assets/src",
    "lint:fix": "eslint --fix src/Application/Public/assets/src",
    "format": "prettier --write \"src/Application/Public/assets/src/**/*.{ts,js,scss}\"",
    "format:check": "prettier --check \"src/Application/Public/assets/src/**/*.{ts,js,scss}\"",
    "css:build": "sass --style=compressed --load-path=node_modules --source-map-urls=relative src/Application/Public/assets/src/index.scss src/Application/Public/assets/dist/css/index.css",
    "css:watch": "./scripts/watch_files_dev.bash css"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.3.1",
    "@popperjs/core": "^2.11.8",
    "bootstrap": "^5.3.8",
    "core-js": "^3.49.0"
  },
  "browserslist": [
    "defaults",
    "not ie 11"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rspack/cli": "^2.1.7",
    "@rspack/core": "^2.1.7",
    "@types/bootstrap": "^5.2.11",
    "dotenv": "^17.4.2",
    "eslint": "^10.8.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-compat": "^7.0.2",
    "eslint-plugin-import-x": "^4.17.1",
    "globals": "^17.8.0",
    "prettier": "^3.9.6",
    "sass": "^1.102.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.65.0"
  }
}
